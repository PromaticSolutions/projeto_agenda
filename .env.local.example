# Copie este arquivo para .env.local e preencha com as chaves do seu projeto
# Supabase (supabase.com > Project Settings > API).
#
# Enquanto estas variáveis não existirem, o app roda inteiro contra dados
# mockados (ver src/lib/mock/) para o front funcionar isolado.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role (secret!)
# NUNCA prefixe com NEXT_PUBLIC_. Usada só em Route Handlers / Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, usada para montar links absolutos (ex.: /[slug]).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
